# GEMINI_API_KEY: Required for Gemini AI API calls (Embeddings and Generation).
GEMINI_API_KEY=

# OPENAI_API_KEY: Required for OpenAI API calls.
OPENAI_API_KEY=

# EMBEDDING_CONFIG: Optional overrides for semantic search.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_API_KEY=

# APP_URL: The URL where this app is hosted.
APP_URL=http://localhost:3000
